server {
    listen 80;
    server_name ${SITE1_DOMAIN};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/challenges;
        default_type "text/plain";
        try_files $uri =404;
    }

    location / {
        return 301 http://${SITE1_WWW_DOMAIN}$request_uri;
    }
}

server {
    listen 80;
    server_name ${SITE1_WWW_DOMAIN};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/challenges;
        default_type "text/plain";
        try_files $uri =404;
    }

    root /var/www/site1;
    index index.php index.html;

    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    location ~ \.php$ {
        fastcgi_pass wordpress_site1:9000;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME /var/www/site1$fastcgi_script_name;
        include /etc/nginx/fastcgi_params;
        fastcgi_read_timeout 300;
    }
}

