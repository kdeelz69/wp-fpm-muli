server {
    listen 80;
    server_name ${SITE2_DOMAIN};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
        default_type "text/plain";
        try_files $uri =404;
    }

    location / {
        return 301 https://${SITE2_WWW_DOMAIN}$request_uri;
    }
}

server {
    listen 80;
    server_name ${SITE2_WWW_DOMAIN};

    location / {
        return 301 https://${SITE2_WWW_DOMAIN}$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name ${SITE2_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${SITE2_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SITE2_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        return 301 https://${SITE2_WWW_DOMAIN}$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name ${SITE2_WWW_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${SITE2_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SITE2_DOMAIN}/privkey.pem;

    root /var/www/site2;
    index index.php index.html;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
        default_type "text/plain";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    location ~ \.php$ {
        fastcgi_pass wordpress_site2:9000;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME /var/www/site2$fastcgi_script_name;
        include /etc/nginx/fastcgi_params;
        fastcgi_param HTTPS on;
        fastcgi_param HTTP_X_FORWARDED_PROTO https;
        fastcgi_read_timeout 300;
    }
}